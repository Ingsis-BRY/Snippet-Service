# Copy to .env (`cp .env.example .env`) and fill in the secrets. .env is gitignored; never commit it.

# Host ports
SNIPPET_SERVICE_PORT=8080
AZURITE_PORT=10000

# Snippet database (compose service `postgres`; the app reaches it through DB_HOST=postgres)
POSTGRES_DB=snippets
POSTGRES_USER=snippets
POSTGRES_PASSWORD=change-me

# Blob storage. The default points at the compose `azurite` service with Azurite's well-known
# development account (devstoreaccount1, a public key documented by Microsoft, not a secret).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;

# Permission service database (compose service `snippet-permission-db`)
PERMISSION_POSTGRES_DB=permissions
PERMISSION_POSTGRES_USER=permissions
PERMISSION_POSTGRES_PASSWORD=change-me

# Optional: permission service image to run
PERMISSION_SERVICE_IMAGE=ghcr.io/ingsis-bry/snippet-permission-service:latest

# Engine proxy (printscript-engine's compose must be up first; it creates the `snippet-searcher` network)
# ENGINE_URL=http://engine-proxy:80

# Auth0 tenant and API identifier, shared with the permission service
AUTH0_DOMAIN=snippet-searcher-bry.us.auth0.com
AUTH0_AUDIENCE=https://snippet-searcher-api

# Machine-to-machine app allowed to read users (read:users), for the user search
AUTH0_M2M_CLIENT_ID=your-m2m-client-id
AUTH0_M2M_CLIENT_SECRET=your-m2m-client-secret

# Only for scripts/get-token.mjs: the native "Snippet Searcher CLI (tests)" app
AUTH0_CLI_CLIENT_ID=your-cli-client-id

# GitHub Packages credentials, passed to the image build as the github_username / github_token secrets.
# Required by `docker compose up --build`. A shell variable wins over this file; note that Windows
# already defines USERNAME, so set it explicitly there.
# USERNAME=your-github-username
# TOKEN=your-github-token-with-read-packages
